extends Node3D
## Руки от первого лица: это руки самой модели сталкера (assets/stalker_arms.glb), а не
## отдельная заглушка. Анимации те же, что у тела: стоит, идёт, бежит; с оружием в руках
## включаются позы fp_rifle_* / fp_pistol_*, где обе руки лежат на оружии.
##
## С оружием руки жёстко привязаны к нему (стоят в системе координат оружия), поэтому качание,
## отдача, прицеливание и перезарядка двигают руки вместе с оружием. Без оружия руки
## привязаны к телу и видны, если посмотреть вниз.

const ARMS_SCENE := "res://assets/stalker_arms.glb"
## Позы рук в Blender запечены под эти числа и под положение оружия (fp_offset + hold_offset)
const EYE_HEIGHT := 1.6   # высота камеры над ногами модели
const BODY_BACK := 0.07   # камера стоит на столько впереди центра тела
const BLEND := 0.35

var _player: CharacterBody3D
var _weapons: Node3D
var _spring_arm: Node3D
var _anim: AnimationPlayer
var _ok: bool = false
var _skeleton: Skeleton3D
var _left_bones: Array[int] = []
var _hand_attach: BoneAttachment3D
var _run_k: float = 0.0   # 1 — нож и бег: руки стоят на теле, как у третьего лица, а не на оружии
var _left_hide: float = 0.0   # 1 — левая рука свёрнута (удар ножом: рука едет вместе с ножом и мелькала бы перед камерой)


func _ready() -> void:
	process_priority = 100   # после WeaponController: к этому моменту оружие уже стоит на месте
	visible = false
	_player = get_parent() as CharacterBody3D
	_weapons = _player.get_node_or_null("WeaponController") as Node3D
	_spring_arm = _player.get_node("SpringArm3D") as Node3D
	if not ResourceLoader.exists(ARMS_SCENE):
		push_warning("FpArms: нет %s, руки от первого лица отключены" % ARMS_SCENE)
		set_process(false)
		return
	var scene := load(ARMS_SCENE) as PackedScene
	if scene == null:
		set_process(false)
		return
	var model := scene.instantiate() as Node3D
	model.basis = Basis(Vector3.UP, PI)   # модель из glb смотрит в +Z, а игра вперёд в -Z
	add_child(model)
	for node in model.find_children("*", "GeometryInstance3D", true, false):
		(node as GeometryInstance3D).cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_anim = model.find_child("AnimationPlayer", true, false) as AnimationPlayer
	_skeleton = model.find_child("Skeleton3D", true, false) as Skeleton3D
	if _skeleton != null:
		for bone_name in ["Shoulder.L", "UpperArm.L"]:
			var bi := _skeleton.find_bone(bone_name)
			if bi >= 0:
				_left_bones.append(bi)
	if _anim != null:
		for anim_name: StringName in _anim.get_animation_list():
			var anim := _anim.get_animation(anim_name)
			if anim != null:
				anim.loop_mode = Animation.LOOP_LINEAR
		play("idle", 1.0)
	_ok = true


## true, если модель рук загрузилась (тогда старые руки-заглушки не нужны)
func is_ready_ok() -> bool:
	return _ok


## Включает анимацию по имени (с суффиксом «_loop» или без) и задаёт её скорость.
func play(base: String, speed: float) -> void:
	if _anim == null:
		return
	var anim_name := ""
	if _anim.has_animation(base):
		anim_name = base
	elif _anim.has_animation(base + "_loop"):
		anim_name = base + "_loop"
	if anim_name != "" and _anim.current_animation != anim_name:
		var phase := -1.0
		var cur := String(_anim.current_animation)
		var gait_now := cur.contains("walk") or cur.contains("run")
		var gait_next := anim_name.contains("walk") or anim_name.contains("run")
		if gait_now and gait_next and _anim.current_animation_length > 0.0:
			phase = fposmod(_anim.current_animation_position / _anim.current_animation_length, 1.0)
		_anim.play(anim_name, BLEND)
		if phase >= 0.0:
			_anim.seek(phase * _anim.current_animation_length, false)
	_anim.speed_scale = speed


func set_speed(speed: float) -> void:
	if _anim != null:
		_anim.speed_scale = speed


func _process(delta: float) -> void:
	visible = _ok and _player.call("is_fp_settled") and float(_player.get("health")) > 0.0
	if not visible:
		return
	var weapon: Variant = _weapons.get("current") if _weapons != null else null
	_update_left_arm(weapon)
	# Бег с ножом: руки двигаются как у тела (те же анимации, что от третьего лица), а не держат нож в кадре
	var knife_run: bool = weapon != null and String(weapon.get("fp_pose")) == "knife" \
			and float(_player.call("get_move_speed")) >= float(_player.get("anim_run_threshold"))
	_run_k = move_toward(_run_k, 1.0 if knife_run else 0.0, delta * 5.0)
	var yaw := Basis(Vector3.UP, _spring_arm.global_rotation.y)
	var body_xf := Transform3D(yaw, _player.global_position + yaw * Vector3(0.0, 0.0, BODY_BACK))
	if weapon != null:
		# Руки стоят в системе координат оружия: тело модели сдвинуто так, чтобы камера
		# оказалась там же, где при запекании поз
		var holder: Node3D = _weapons.call("get_holder")
		var nominal_fp: Vector3 = _weapons.get("fp_offset")
		var hold: Vector3 = weapon.get("hold_offset")
		var local := Vector3(0.0, -EYE_HEIGHT, BODY_BACK) - nominal_fp - hold
		var weapon_xf: Transform3D = holder.global_transform * Transform3D(Basis.IDENTITY, local)
		global_transform = weapon_xf.interpolate_with(body_xf, smoothstep(0.0, 1.0, _run_k)) if _run_k > 0.0 else weapon_xf
	else:
		# Без оружия: руки у тела, поворачиваются только по горизонтали, как настоящие
		global_transform = body_xf


## Кладёт оружие в правую руку модели (кость Hand.R) с заданным положением относительно кисти.
func attach_weapon(model: Node3D, xf: Transform3D) -> bool:
	if _skeleton == null or _skeleton.find_bone("Hand.R") < 0:
		return false
	if _hand_attach == null:
		_hand_attach = BoneAttachment3D.new()
		_hand_attach.bone_name = "Hand.R"
		_skeleton.add_child(_hand_attach)
	clear_weapon()
	model.transform = xf
	_hand_attach.add_child(model)
	return true


func clear_weapon() -> void:
	if _hand_attach == null:
		return
	for child in _hand_attach.get_children():
		child.queue_free()


## Во время ударов ножом левая рука сворачивается в точку у плеча (за кадром), потом возвращается.
func _update_left_arm(weapon: Variant) -> void:
	if _skeleton == null or _left_bones.is_empty():
		return
	var want_hide := weapon != null and String(weapon.get("fp_pose")) == "knife" and int(_weapons.get("_atk_step")) >= 0
	_left_hide = move_toward(_left_hide, 1.0 if want_hide else 0.0, get_process_delta_time() * (30.0 if want_hide else 3.0))
	var k := maxf(1.0 - _left_hide, 0.001)
	for bi: int in _left_bones:
		_skeleton.set_bone_pose_scale(bi, Vector3(k, k, k))
