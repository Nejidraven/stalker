extends Node3D
## Оружие игрока: выбор, прицеливание, одиночный и автоматический огонь, перезарядка.
## Стрельба мгновенная (луч от камеры), без сетевой части. Сам узел служит «рукой»:
## он поворачивается за камерой, а модель оружия висит на нём.
##
## Боёвка в духе Bodycam: оружие и руки физически связаны с телом, качаются при ходьбе и
## поворотах, бег портит точность и опускает ствол, прицеливание через мушку уменьшает
## разброс и отдачу, перезарядка в стрессе (мало здоровья, только что попали) медленнее.
##
## Управление: ЛКМ огонь, ПКМ прицелиться, R перезарядка, 1/2 выбор, B режим огня.

signal aim_changed(aiming: bool)
signal weapon_changed(weapon: Weapon)
signal ammo_changed(in_magazine: int, reserve: int, mode_text: String)
signal reload_started(duration: float)
signal hit_confirmed(killed: bool)
signal notice(text: String)

const HIT_SOUND := "res://assets/audio/bullet_hit.wav"
const CLICK_SOUND := "res://assets/audio/empty_click.wav"
const RELOAD_SOUND := "res://assets/audio/reload.wav"
const MAX_HOLES := 40

## Положение оружия в руках у модели (третье лицо): относительно кости Chest.
## Рассчитано в Blender вместе с позами рук (низко / у плеча при прицеливании).
const TP_LOW := {
	"rifle": Transform3D(Basis(Vector3(-1.00000, 0.00000, 0.00000), Vector3(0.00000, 0.90631, 0.42262), Vector3(0.00000, 0.42262, -0.90631)), Vector3(-0.13000, 0.05800, 0.30000)),
	"pistol": Transform3D(Basis(Vector3(-1.00000, 0.00000, 0.00000), Vector3(0.00000, 0.97815, 0.20791), Vector3(0.00000, 0.20791, -0.97815)), Vector3(-0.06000, 0.07800, 0.38000)),
}
const TP_AIM := {
	"rifle": Transform3D(Basis(Vector3(-1.00000, 0.00000, 0.00000), Vector3(0.00000, 1.00000, 0.00000), Vector3(0.00000, 0.00000, -1.00000)), Vector3(-0.09000, 0.35000, 0.30000)),
	"pistol": Transform3D(Basis(Vector3(-1.00000, 0.00000, 0.00000), Vector3(0.00000, 1.00000, 0.00000), Vector3(0.00000, 0.00000, -1.00000)), Vector3(-0.09000, 0.33000, 0.52000)),
}

enum Mode { SINGLE, AUTO }

## Положение «руки» относительно камеры-рычага (SpringArm3D), а не мира: так оружие
## не смещается на экране при повороте камеры. x вправо, y вверх, z вперёд (минус).
@export var fp_offset: Vector3 = Vector3(0.12, -0.11, 0.0)
@export var tp_offset: Vector3 = Vector3(0.30, -0.35, 0.0)

var current: Weapon = null

var _player: CharacterBody3D
var _inventory: Inventory
var _mags: Dictionary = {}    # id оружия -> патронов в магазине
var _modes: Dictionary = {}   # id оружия -> Mode
var _cooldown: float = 0.0
var _reloading: bool = false
var _reload_left: float = 0.0
var _bloom: float = 0.0
var _kick: float = 0.0
var _flash_time: float = 0.0
var _empty_notice_cd: float = 0.0
var _holes: Array[Node3D] = []

var _model_holder: Node3D
var _tp_attach: BoneAttachment3D
var _tp_model: Node3D
var _muzzle: Node3D
var _flash_light: OmniLight3D
var _flash_quad: MeshInstance3D
var _shot_player: AudioStreamPlayer3D
var _click_player: AudioStreamPlayer3D
var _reload_player: AudioStreamPlayer3D
var _scene_cache: Dictionary = {}
var _offset: Vector3 = Vector3(0.30, -0.35, 0.0)

var _camera: Camera3D
var _base_fov: float = 75.0
var _hands: Node3D
var _aiming: bool = false
var _aim_blend: float = 0.0
var _sprint_blend: float = 0.0
var _sway: Vector2 = Vector2.ZERO
var _last_rot: Vector2 = Vector2.ZERO
var _bob_t: float = 0.0
var _kick_rot: float = 0.0
var _recoil_accum: float = 0.0   # сколько градусов камера ушла вверх от стрельбы (часть вернётся)
var _since_shot: float = 10.0
var _reload_total: float = 1.0


func _ready() -> void:
	_player = get_parent() as CharacterBody3D
	_inventory = _player.get_node_or_null("Inventory") as Inventory
	if _inventory != null:
		_inventory.changed.connect(_on_inventory_changed)
		_inventory.equipment_changed.connect(_on_equipment_changed)
	_camera = _player.get_node("SpringArm3D/Camera3D") as Camera3D
	_base_fov = _camera.fov
	_build_nodes()
	_setup_input_map()


func _unhandled_input(event: InputEvent) -> void:
	if Input.mouse_mode != Input.MOUSE_MODE_CAPTURED:
		return
	if event.is_action_pressed("weapon_1"):
		_select_slot(1)
	elif event.is_action_pressed("weapon_2"):
		_select_slot(2)
	elif event.is_action_pressed("reload"):
		_start_reload()
	elif event.is_action_pressed("fire_mode"):
		_toggle_mode()


## Рука «приклеена» к камере: повторяет её поворот вокруг рычага, поэтому на экране
## оружие стоит на месте. При смене вида смещение плавно меняется.
func _process(delta: float) -> void:
	var arm := _player.get_node("SpringArm3D") as Node3D
	var first_person: bool = _player.call("is_first_person")
	var armed := current != null
	var sprinting: bool = _player.call("is_sprinting")

	# Прицеливание (ПКМ): не во время бега и перезарядки
	var want_aim := armed and not _reloading and not sprinting \
		and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED and Input.is_action_pressed("aim")
	if want_aim != _aiming:
		_aiming = want_aim
		aim_changed.emit(_aiming)
	_aim_blend = move_toward(_aim_blend, 1.0 if _aiming else 0.0, delta * 8.0)
	_sprint_blend = move_toward(_sprint_blend, 1.0 if (armed and sprinting) else 0.0, delta * 6.0)

	# При прицеливании поворот мыши и шаг медленнее, обзор уже
	_player.set("look_scale", lerpf(1.0, 0.55, _aim_blend))
	_player.set("move_scale", lerpf(1.0, 0.65, _aim_blend))
	var ads_fov := current.ads_fov if armed else _base_fov
	_camera.fov = lerpf(_base_fov, ads_fov, _aim_blend)

	# Положение руки относительно камеры. От первого лица при прицеливании оружие
	# встаёт так, чтобы мушка оказалась на линии взгляда.
	_offset = _offset.lerp(fp_offset if first_person else tp_offset, minf(delta * 12.0, 1.0))
	var offset := _offset
	if armed and first_person:
		offset = _offset.lerp(current.ads_offset, _aim_blend)
	transform = arm.transform * Transform3D(Basis.IDENTITY, offset)

	_update_weapon_motion(delta, arm, first_person)
	_update_tp_weapon(first_person)

	if _flash_time > 0.0:
		_flash_time -= delta
		if _flash_time <= 0.0:
			_flash_light.visible = false
			_flash_quad.visible = false
	_bloom = move_toward(_bloom, 0.0, delta * 3.0)
	_empty_notice_cd = maxf(_empty_notice_cd - delta, 0.0)


## Живое оружие: инерция при повороте камеры, покачивание при ходьбе, дыхание,
## опущенный ствол на бегу, подъём ствола от отдачи, движение рук при перезарядке.
func _update_weapon_motion(delta: float, arm: Node3D, first_person: bool) -> void:
	# Инерция: оружие чуть отстаёт от поворота камеры
	var rot := Vector2(arm.rotation.x, arm.rotation.y)
	var velocity := Vector2(
		angle_difference(_last_rot.x, rot.x), angle_difference(_last_rot.y, rot.y)
	) / maxf(delta, 0.0001)
	_last_rot = rot
	var sway_target := (-velocity * 0.010).clamp(Vector2(-0.12, -0.12), Vector2(0.12, 0.12))
	_sway = _sway.lerp(sway_target, minf(delta * 9.0, 1.0))

	if current == null:
		return

	# Покачивание при ходьбе и дыхание слабеют при прицеливании
	var speed: float = _player.call("get_move_speed")
	var grounded: bool = _player.is_on_floor()
	var move_k := clampf(speed / 7.5, 0.0, 1.0) if grounded else 0.0
	_bob_t += delta * (5.0 + speed * 1.3)
	var calm := 1.0 - 0.8 * _aim_blend
	var bob := Vector3(cos(_bob_t) * 0.008, -absf(sin(_bob_t)) * 0.010, 0.0) * move_k * calm
	bob.y += sin(Time.get_ticks_msec() * 0.0013) * 0.0015 * calm

	# Перезарядка: руки с оружием уходят вниз и вбок, потом возвращаются
	var reload_k := 0.0
	if _reloading:
		var progress := 1.0 - clampf(_reload_left / maxf(_reload_total, 0.01), 0.0, 1.0)
		reload_k = sin(progress * PI)

	_kick = move_toward(_kick, 0.0, delta * 0.6)
	_kick_rot = move_toward(_kick_rot, 0.0, delta * 0.5)

	# Бег: ствол опущен и уведён в сторону
	var sprint_off := Vector3(-0.06, -0.05, 0.05) * _sprint_blend
	var reload_off := Vector3(-0.03, -0.14, 0.05) * reload_k
	_model_holder.position = current.hold_offset + Vector3(0.0, 0.0, _kick) + bob + sprint_off + reload_off
	_model_holder.rotation = Vector3(
		_sway.x + _kick_rot - 0.35 * _sprint_blend - 0.35 * reload_k,
		_sway.y + 0.55 * _sprint_blend,
		0.5 * reload_k + clampf(-_sway.y * 0.6, -0.1, 0.1)
	)
	if _hands != null and is_instance_valid(_hands):
		_hands.visible = first_person   # руки видны только от первого лица


func _current_spread() -> float:
	var spread := current.spread_deg
	var speed: float = _player.call("get_move_speed")
	spread += clampf(speed / 7.5, 0.0, 1.0) * 2.5   # на ходу и особенно на бегу точность хуже
	if not _player.is_on_floor():
		spread += 3.0
	spread += _bloom
	return spread * lerpf(1.0, 0.35, _aim_blend)    # мушка собирает пули в кучу


func _physics_process(delta: float) -> void:
	_cooldown = maxf(_cooldown - delta, 0.0)

	# Часть отдачи камера возвращает сама, если стрельба прекратилась
	_since_shot += delta
	if _recoil_accum > 0.0 and _since_shot > 0.12 and not Input.is_action_pressed("fire"):
		var step := minf(_recoil_accum, 4.0 * delta)
		_recoil_accum -= step
		_player.call("add_recoil", -step, 0.0)

	if _reloading:
		_reload_left -= delta
		if _reload_left <= 0.0:
			_finish_reload()
		return

	if current == null or get_tree().paused or Input.mouse_mode != Input.MOUSE_MODE_CAPTURED:
		return
	if float(_player.get("health")) <= 0.0:
		return
	if _player.call("is_sprinting"):
		return   # на бегу оружие опущено, стрелять нельзя

	var mode: int = _modes.get(current.id, Mode.SINGLE)
	var wants_fire := Input.is_action_pressed("fire") if mode == Mode.AUTO else Input.is_action_just_pressed("fire")
	if wants_fire and _cooldown <= 0.0:
		_try_fire()


# --- Выбор оружия --------------------------------------------------------

## Берёт оружие в руки; если оно уже в руках, убирает.
func toggle_weapon(weapon: Weapon) -> void:
	if current != null and current.id == weapon.id:
		holster()
	else:
		equip(weapon)


func equip(weapon: Weapon) -> void:
	if _inventory == null or not _inventory.is_equipped(weapon):
		return   # в руки можно взять только то, что лежит в слоте снаряжения
	_cancel_reload()
	current = weapon
	if not _mags.has(weapon.id):
		_mags[weapon.id] = 0
	if not _modes.has(weapon.id):
		_modes[weapon.id] = Mode.AUTO if weapon.can_auto else Mode.SINGLE
	_cooldown = 0.25   # короткая пауза: оружие доставали
	_build_model()
	weapon_changed.emit(weapon)
	_emit_ammo()


func holster() -> void:
	_cancel_reload()
	current = null
	_hands = null
	if _aiming:
		_aiming = false
		aim_changed.emit(false)
	if _model_holder != null:
		for child in _model_holder.get_children():
			if child.is_in_group("weapon_model"):
				child.queue_free()
		_model_holder.visible = false
	weapon_changed.emit(null)


## Узел, в котором лежит модель оружия: руки от первого лица привязываются к нему.
func get_holder() -> Node3D:
	return _model_holder


## true, если у игрока есть руки модели (тогда старые руки-заглушки не показываются)
func _has_arm_model() -> bool:
	var arms := _player.get_node_or_null("FpArms")
	return arms != null and bool(arms.call("is_ready_ok"))


func _select_slot(slot: int) -> void:
	if _inventory == null:
		return
	# Клавиши 1/2 переключают между оружием, которое лежит в слотах снаряжения
	for equipped: Item in _inventory.equipment.values():
		if equipped is Weapon and (equipped as Weapon).slot == slot:
			toggle_weapon(equipped as Weapon)
			return
	notice.emit("В слоте %d нет оружия. Перетащите его в слот снаряжения (Tab)" % slot)


func _toggle_mode() -> void:
	if current == null or not (current.can_single and current.can_auto):
		return
	var mode: int = _modes.get(current.id, Mode.SINGLE)
	_modes[current.id] = Mode.SINGLE if mode == Mode.AUTO else Mode.AUTO
	_emit_ammo()


func _on_inventory_changed() -> void:
	if current != null and not _inventory.is_equipped(current):
		holster()   # оружие сняли или выбросили
	elif current != null:
		_emit_ammo()


## Оружие, положенное в слот снаряжения, сразу берётся в руки.
func _on_equipment_changed(slot_name: StringName) -> void:
	var item := _inventory.get_equipped(slot_name)
	if item is Weapon:
		equip(item as Weapon)


# --- Стрельба ------------------------------------------------------------

func _try_fire() -> void:
	var in_mag: int = _mags.get(current.id, 0)
	if in_mag <= 0:
		if _reserve() > 0:
			_start_reload()
		else:
			_cooldown = 0.25
			_click_player.play()
			if _empty_notice_cd <= 0.0:
				notice.emit("Нет патронов")
				_empty_notice_cd = 1.5
		return

	_mags[current.id] = in_mag - 1
	_cooldown = 60.0 / maxf(current.fire_rate, 1.0)
	_fire_bullet()
	_emit_ammo()


func _fire_bullet() -> void:
	var camera := get_viewport().get_camera_3d()
	if camera == null:
		return
	var arm := _player.get_node("SpringArm3D") as Node3D
	var cam_xf := camera.global_transform
	var forward := -cam_xf.basis.z
	# Луч начинается на уровне глаз игрока, чтобы не цеплять предметы позади него
	var start := cam_xf.origin + forward * cam_xf.origin.distance_to(arm.global_position)

	# В прицеливании пуля летит туда, куда смотрит само оружие (по линии прицела),
	# а не в центр экрана: при качании и отдаче оружие чуть отстаёт от камеры
	var base_dir := forward
	var base_right := cam_xf.basis.x
	var base_up := cam_xf.basis.y
	if _aim_blend > 0.01 and _player.call("is_first_person") and _model_holder != null:
		var holder_xf := _model_holder.global_transform
		var weapon_dir := (-holder_xf.basis.z).normalized()
		base_dir = forward.slerp(weapon_dir, _aim_blend).normalized()
		start = start.lerp(holder_xf.origin, _aim_blend)
		base_right = base_dir.cross(Vector3.UP).normalized()
		base_up = base_right.cross(base_dir).normalized()

	var cone := deg_to_rad(_current_spread())
	var angle := randf() * TAU
	var radius := sqrt(randf()) * tan(cone)
	var dir := (base_dir + base_right * cos(angle) * radius + base_up * sin(angle) * radius).normalized()
	var end := start + dir * current.max_range

	var query := PhysicsRayQueryParameters3D.create(start, end, 1)
	query.exclude = [_player.get_rid()]
	var hit := get_world_3d().direct_space_state.intersect_ray(query)

	var tracer_end := end
	if not hit.is_empty():
		tracer_end = hit["position"]
		_apply_hit(hit)

	_spawn_tracer(_muzzle.global_position, tracer_end)
	_muzzle_flash()
	_shot_player.play()

	# Отдача: камера подпрыгивает, оружие дёргается назад
	_bloom = minf(_bloom + current.spread_deg * 0.4, current.spread_deg * 3.0)
	_kick = minf(_kick + 0.04, 0.08)
	var recoil_scale := lerpf(1.0, 0.6, _aim_blend)   # прицеливание смягчает отдачу
	_kick_rot = minf(_kick_rot + 0.03 * recoil_scale, 0.12)
	var pitch := current.recoil_pitch_deg * recoil_scale * randf_range(0.8, 1.2)
	var yaw_dir := 1.0 if randf() < 0.5 else -1.0
	_player.call("add_recoil", pitch, current.recoil_yaw_deg * recoil_scale * yaw_dir * randf())
	_recoil_accum += pitch * 0.6   # 60% подъёма камера потом вернёт сама
	_since_shot = 0.0


func _apply_hit(hit: Dictionary) -> void:
	var collider := hit["collider"] as Node
	var point: Vector3 = hit["position"]
	var normal: Vector3 = hit["normal"]
	if collider != null and collider.has_method("apply_hit"):
		var result: Variant = collider.call("apply_hit", current.damage, point, normal)
		hit_confirmed.emit(result is bool and result)
		_spawn_sparks(point, normal, Color(1.0, 0.75, 0.35))
		return
	if collider != null and collider.has_method("take_damage"):
		collider.call("take_damage", current.damage)
		hit_confirmed.emit(false)
	_spawn_sparks(point, normal, Color(0.9, 0.85, 0.7))
	_spawn_hole(point, normal)


# --- Перезарядка ---------------------------------------------------------

func _reserve() -> int:
	if _inventory == null or current == null:
		return 0
	return _inventory.get_count(current.ammo_id)


func _start_reload() -> void:
	if current == null or _reloading:
		return
	if int(_mags.get(current.id, 0)) >= current.magazine_size:
		return
	if _reserve() <= 0:
		if _empty_notice_cd <= 0.0:
			notice.emit("Нет патронов")
			_empty_notice_cd = 1.5
		return
	# Стресс замедляет перезарядку: мало здоровья или только что попали, руки торопятся и дрожат
	var health_fraction := float(_player.get("health")) / maxf(float(_player.get("max_health")), 1.0)
	var trauma: float = _player.call("get_trauma")
	var stress := clampf((1.0 - health_fraction) * 0.6 + trauma * 0.6, 0.0, 1.0)
	_reload_total = current.reload_time * (1.0 + stress * 0.8)
	if randf() < trauma * 0.5:
		_reload_total += 0.5   # выронил или замешкался
	_reloading = true
	_reload_left = _reload_total
	_reload_player.play()
	reload_started.emit(_reload_total)


func _finish_reload() -> void:
	_reloading = false
	if current == null:
		return
	var need := current.magazine_size - int(_mags.get(current.id, 0))
	var taken := _inventory.remove_item(current.ammo_id, mini(need, _reserve()))
	_mags[current.id] = int(_mags.get(current.id, 0)) + taken
	_cooldown = 0.15
	_emit_ammo()


func _cancel_reload() -> void:
	if _reloading:
		_reloading = false
		_reload_player.stop()


func _emit_ammo() -> void:
	if current == null:
		return
	var mode: int = _modes.get(current.id, Mode.SINGLE)
	var text := "ОЧЕРЕДЬ" if mode == Mode.AUTO else "ОДИНОЧНЫЕ"
	ammo_changed.emit(int(_mags.get(current.id, 0)), _reserve(), text)


# --- Построение и эффекты -------------------------------------------------

func _build_nodes() -> void:
	_model_holder = Node3D.new()
	_model_holder.visible = false
	add_child(_model_holder)

	_muzzle = Node3D.new()
	_model_holder.add_child(_muzzle)

	_flash_light = OmniLight3D.new()
	_flash_light.light_color = Color(1.0, 0.8, 0.5)
	_flash_light.light_energy = 3.0
	_flash_light.omni_range = 6.0
	_flash_light.shadow_enabled = false
	_flash_light.visible = false
	_muzzle.add_child(_flash_light)

	_flash_quad = MeshInstance3D.new()
	var quad := QuadMesh.new()
	quad.size = Vector2(0.28, 0.28)
	quad.material = Fx.particle_material(Color(1.0, 0.7, 0.3))
	_flash_quad.mesh = quad
	_flash_quad.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_flash_quad.visible = false
	_muzzle.add_child(_flash_quad)

	_shot_player = _make_audio(null, -14.0)
	_shot_player.max_polyphony = 4
	_click_player = _make_audio(Fx.load_stream(CLICK_SOUND, false), -14.0)
	_reload_player = _make_audio(Fx.load_stream(RELOAD_SOUND, false), -16.0)


func _make_audio(stream: AudioStream, volume_db: float) -> AudioStreamPlayer3D:
	var p := AudioStreamPlayer3D.new()
	p.stream = stream
	p.volume_db = volume_db
	p.unit_size = 10.0
	p.max_distance = 150.0
	_model_holder.add_child(p)
	return p


func _build_model() -> void:
	for child in _model_holder.get_children():
		if child.is_in_group("weapon_model"):
			child.queue_free()

	var model: Node3D = null
	if current.model_path != "" and ResourceLoader.exists(current.model_path):
		if not _scene_cache.has(current.model_path):
			_scene_cache[current.model_path] = load(current.model_path)
		var scene := _scene_cache[current.model_path] as PackedScene
		if scene != null:
			model = scene.instantiate() as Node3D
	if model == null:
		# Запасной вариант, если модели нет: простой брусок
		var fallback := MeshInstance3D.new()
		var box := BoxMesh.new()
		box.size = Vector3(0.04, 0.06, 0.3)
		fallback.mesh = box
		model = fallback
	model.add_to_group("weapon_model")
	for node in model.find_children("*", "GeometryInstance3D", true, false):
		(node as GeometryInstance3D).cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_model_holder.add_child(model)
	_model_holder.visible = true
	_build_tp_model()
	_muzzle.position = current.muzzle_offset

	# Временные руки: стоят в тех же координатах, что и модель оружия
	_hands = null
	if not _has_arm_model() and current.hands_path != "" and ResourceLoader.exists(current.hands_path):
		if not _scene_cache.has(current.hands_path):
			_scene_cache[current.hands_path] = load(current.hands_path)
		var hands_scene := _scene_cache[current.hands_path] as PackedScene
		if hands_scene != null:
			_hands = hands_scene.instantiate() as Node3D
			_hands.add_to_group("weapon_model")
			for node in _hands.find_children("*", "GeometryInstance3D", true, false):
				(node as GeometryInstance3D).cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			_model_holder.add_child(_hands)

	_shot_player.stream = Fx.load_stream(current.shot_sound_path, false)
	_shot_player.volume_db = current.shot_volume_db


func _muzzle_flash() -> void:
	_flash_light.visible = true
	_flash_quad.visible = true
	_flash_quad.rotation.z = randf() * TAU
	_flash_time = 0.04


func _scene_root() -> Node:
	return get_tree().current_scene if get_tree().current_scene != null else get_tree().root


func _spawn_tracer(from: Vector3, to: Vector3) -> void:
	var length := from.distance_to(to)
	if length < 0.5:
		return
	var mesh := MeshInstance3D.new()
	var box := BoxMesh.new()
	box.size = Vector3(0.012, 0.012, length)
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	mat.albedo_color = Color(1.0, 0.85, 0.5, 0.8)
	box.material = mat
	mesh.mesh = box
	mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_scene_root().add_child(mesh)
	mesh.global_position = (from + to) * 0.5
	mesh.look_at(to, Vector3.UP if absf((to - from).normalized().y) < 0.99 else Vector3.RIGHT)
	var tween := mesh.create_tween()
	tween.tween_property(mat, "albedo_color:a", 0.0, 0.07)
	tween.tween_callback(mesh.queue_free)


func _spawn_sparks(point: Vector3, normal: Vector3, color: Color) -> void:
	var sparks := CPUParticles3D.new()
	sparks.one_shot = true
	sparks.emitting = false
	sparks.amount = 8
	sparks.lifetime = 0.35
	sparks.explosiveness = 1.0
	sparks.direction = normal
	sparks.spread = 55.0
	sparks.initial_velocity_min = 1.5
	sparks.initial_velocity_max = 4.0
	sparks.gravity = Vector3(0.0, -9.0, 0.0)
	var mesh := BoxMesh.new()
	mesh.size = Vector3(0.025, 0.025, 0.025)
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.albedo_color = color
	mesh.material = mat
	sparks.mesh = mesh
	_scene_root().add_child(sparks)
	sparks.global_position = point + normal * 0.02
	sparks.emitting = true
	get_tree().create_timer(0.8).timeout.connect(sparks.queue_free)


## Тёмное пятно-след от пули на неподвижных поверхностях (старые исчезают).
func _spawn_hole(point: Vector3, normal: Vector3) -> void:
	var hole := MeshInstance3D.new()
	var quad := QuadMesh.new()
	quad.size = Vector2(0.14, 0.14)
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = Color(0.0, 0.0, 0.0, 0.85)
	mat.albedo_texture = Fx.soft_dot()
	quad.material = mat
	hole.mesh = quad
	hole.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_scene_root().add_child(hole)
	hole.global_position = point + normal * 0.015
	var up := Vector3.UP if absf(normal.y) < 0.99 else Vector3.RIGHT
	hole.look_at(point - normal, up)   # лицевая сторона квадрата смотрит вдоль нормали
	_holes.append(hole)
	if _holes.size() > MAX_HOLES:
		var old: Node3D = _holes.pop_front()
		if is_instance_valid(old):
			old.queue_free()


# --- Управление ----------------------------------------------------------

func _setup_input_map() -> void:
	var keys: Dictionary = {
		"weapon_1": KEY_1,
		"weapon_2": KEY_2,
		"reload": KEY_R,
		"fire_mode": KEY_B,
	}
	for action: String in keys:
		if InputMap.has_action(action):
			continue
		InputMap.add_action(action)
		var key_event := InputEventKey.new()
		key_event.physical_keycode = keys[action]
		InputMap.action_add_event(action, key_event)
	if not InputMap.has_action("fire"):
		InputMap.add_action("fire")
		var mouse_event := InputEventMouseButton.new()
		mouse_event.button_index = MOUSE_BUTTON_LEFT
		InputMap.action_add_event("fire", mouse_event)
	if not InputMap.has_action("aim"):
		InputMap.add_action("aim")
		var aim_event := InputEventMouseButton.new()
		aim_event.button_index = MOUSE_BUTTON_RIGHT
		InputMap.action_add_event("aim", aim_event)


# --- Оружие в руках у модели (третье лицо) --------------------------------

## Копия оружия на кости груди: едет вместе с телом, руки в анимациях лежат на ней.
func _build_tp_model() -> void:
	if _tp_model != null and is_instance_valid(_tp_model):
		_tp_model.queue_free()
	_tp_model = null
	var skeleton := _find_player_skeleton()
	if skeleton == null:
		return
	if _tp_attach == null or not is_instance_valid(_tp_attach):
		_tp_attach = BoneAttachment3D.new()
		_tp_attach.name = "TpWeaponAttach"
		skeleton.add_child(_tp_attach)
		_tp_attach.bone_name = "Chest"
	var model: Node3D = null
	if current.model_path != "" and _scene_cache.has(current.model_path):
		model = (_scene_cache[current.model_path] as PackedScene).instantiate() as Node3D
	if model == null:
		return
	for node in model.find_children("*", "GeometryInstance3D", true, false):
		(node as GeometryInstance3D).cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	_tp_attach.add_child(model)
	_tp_model = model


func _find_player_skeleton() -> Skeleton3D:
	var mesh := _player.get_node_or_null("Mesh")
	if mesh == null:
		return null
	return mesh.find_child("Skeleton3D", true, false) as Skeleton3D


func _update_tp_weapon(first_person: bool) -> void:
	if current == null or _tp_model == null or not is_instance_valid(_tp_model):
		return
	var kind := String(current.fp_pose)
	if not TP_LOW.has(kind):
		kind = "rifle"
	_tp_model.visible = not first_person
	_tp_model.transform = (TP_LOW[kind] as Transform3D).interpolate_with(TP_AIM[kind] as Transform3D, _aim_blend)
	for child in _model_holder.get_children():
		if child.is_in_group("weapon_model"):
			(child as Node3D).visible = first_person
	if not first_person:
		# вспышка и звук выстрела идут от настоящего ствола
		_model_holder.global_transform = _tp_model.global_transform
